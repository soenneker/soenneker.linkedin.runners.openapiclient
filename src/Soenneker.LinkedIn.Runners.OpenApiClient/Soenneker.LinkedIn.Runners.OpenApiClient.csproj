<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A runner that regenerates and updates Soenneker.LinkedIn.OpenApiClient.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.LinkedIn.Runners.OpenApiClient</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="4.0.1409" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="Soenneker.Kiota.Util" Version="4.0.144" />
        <PackageReference Include="Soenneker.Managers.Runners" Version="4.0.2604" />
        <PackageReference Include="Soenneker.OpenApi.Fixer" Version="4.0.378" />
        <PackageReference Include="Soenneker.Playwrights.Installation" Version="4.0.209" />
        <PackageReference Include="Soenneker.Postman.Converter" Version="4.0.134" />
        <PackageReference Include="Soenneker.OpenApi.Merger" Version="4.0.205" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Enums.DeployEnvironment" Version="4.0.245" />
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.124" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Documentation/ExtractArticle.js" />
    </ItemGroup>
</Project>
